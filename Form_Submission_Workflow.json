{
  "name": "Form Submission → Google Sheets → Confirmation & Notification Emails",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Contact / Registration Form",
        "formDescription": "Please fill in your details below.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Full Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Phone Number",
              "requiredField": true
            },
            {
              "fieldLabel": "Address",
              "fieldType": "textarea",
              "requiredField": true
            }
          ]
        },
        "options": {
          "buttonLabel": "Submit"
        }
      },
      "id": "1a1a1a1a-0001-4b1b-9c1c-000000000001",
      "name": "On form submission",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [-400, 0],
      "webhookId": "form-submission-webhook-001"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "PUT_YOUR_GOOGLE_SHEET_ID_HERE"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Full Name": "={{ $json['Full Name'] }}",
            "Email": "={{ $json['Email'] }}",
            "Phone Number": "={{ $json['Phone Number'] }}",
            "Address": "={{ $json['Address'] }}",
            "Submitted At": "={{ $now.format('yyyy-MM-dd HH:mm:ss') }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "Full Name", "displayName": "Full Name", "type": "string" },
            { "id": "Email", "displayName": "Email", "type": "string" },
            { "id": "Phone Number", "displayName": "Phone Number", "type": "string" },
            { "id": "Address", "displayName": "Address", "type": "string" },
            { "id": "Submitted At", "displayName": "Submitted At", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "1a1a1a1a-0002-4b1b-9c1c-000000000002",
      "name": "Store in Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-160, 0],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "PUT_YOUR_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $json['Email'] }}",
        "subject": "Your Form Submission Was Received",
        "emailType": "text",
        "message": "=Hi {{ $json['Full Name'] }},\n\nThank you for your submission! We have successfully received the following details:\n\nFull Name: {{ $json['Full Name'] }}\nEmail: {{ $json['Email'] }}\nPhone Number: {{ $json['Phone Number'] }}\nAddress: {{ $json['Address'] }}\n\nWe will get back to you shortly.\n\nBest regards,\nThe Team",
        "options": {}
      },
      "id": "1a1a1a1a-0003-4b1b-9c1c-000000000003",
      "name": "Send Confirmation Email to User",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [80, -120],
      "webhookId": "confirmation-email-node",
      "credentials": {
        "gmailOAuth2": {
          "id": "PUT_YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "PUT_FORM_CREATOR_EMAIL_HERE@example.com",
        "subject": "New Form Submission Received",
        "emailType": "text",
        "message": "=A new form has been submitted. Details below:\n\nFull Name: {{ $json['Full Name'] }}\nEmail: {{ $json['Email'] }}\nPhone Number: {{ $json['Phone Number'] }}\nAddress: {{ $json['Address'] }}\n\nThis submission has already been saved to Google Sheets.",
        "options": {}
      },
      "id": "1a1a1a1a-0004-4b1b-9c1c-000000000004",
      "name": "Send Notification Email to Creator",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [80, 120],
      "webhookId": "notification-email-node",
      "credentials": {
        "gmailOAuth2": {
          "id": "PUT_YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    }
  ],
  "connections": {
    "On form submission": {
      "main": [
        [
          {
            "node": "Store in Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Store in Google Sheets": {
      "main": [
        [
          {
            "node": "Send Confirmation Email to User",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Notification Email to Creator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "instanceId": "form-to-sheets-to-emails"
  }
}
